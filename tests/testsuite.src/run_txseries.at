prog.cbl: in paragraph 'CICS-API-TRIGGER':
prog.cbl:14: warning: GO TO SECTION 'CICS-API-ERROR'
])
AT_CHECK([$COMPILE_ONLY -std=txseries prog.cbl], [0], [],
[prog.cbl: in section 'CICS-API':
prog.cbl: in paragraph 'CICS-API-TRIGGER':
prog.cbl:14: warning: GO TO SECTION 'CICS-API-ERROR'
])
