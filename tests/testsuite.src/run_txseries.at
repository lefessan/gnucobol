         [0], [], [])

AT_CLEANUP


AT_SETUP([language method loaded with RTLD_LOCAL])
AT_KEYWORDS([runtxseries txseries cobcld dlopen])

# TXSeries may load its language method (cicsprCOBCLD, which contains
# libcobcld) with RTLD_LOCAL; the programs call the CICS interface of
# the method (CICSAPIE...) by static calls: libcobcld makes the method
# global so that the program can be loaded

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      PROG.
       ENVIRONMENT      DIVISION.
       SPECIAL-NAMES.
           CALL-CONVENTION 8 IS LITLINK.
       DATA             DIVISION.
       LINKAGE          SECTION.
       01 DFHEIBLK      PIC X(8).
       01 DFHCOMMAREA   PIC X(4).
       PROCEDURE        DIVISION USING DFHEIBLK DFHCOMMAREA.
           CALL LITLINK "CICSAPIX" USING DFHCOMMAREA
           DISPLAY "PROG " DFHCOMMAREA
           GOBACK.
])

AT_DATA([method.c], [[
#include <stdio.h>
#include <string.h>
#include <setjmp.h>

typedef struct cob_rtd cob_rtd;
extern cob_rtd *cob_get_rtd (void);
extern void cob_init (cob_rtd *, int, char **);
extern cob_rtd *cob_enterprise_set_current_region (cob_rtd *, int);
extern void cob_enterprise_cancel_region (cob_rtd *, int, int);
extern void *cob_resolve (cob_rtd *, const char *);
extern char *cob_resolve_error (cob_rtd *);

/* the CICS interface of the method */
int
CICSAPIX (char *commarea)
{
   memcpy (commarea, "DONE", 4);
   return 0;
}

int
method_run (const char *name)
{
   static char eib[8];
   char commarea[4] = { 'I', 'N', 'I', 'T' };
   int (*entry) (char *, char *);
   cob_rtd *rtd = cob_get_rtd ();
   cob_rtd *r;

   *(int *)rtd = 1;
   cob_init (rtd, 0, NULL);
   cob_enterprise_cancel_region (rtd, 1, 0);
   r = cob_enterprise_set_current_region (rtd, 1);
   entry = (int (*) (char *, char *))cob_resolve (r, name);
   if (entry == NULL) {
      printf ("load %s: %s\n", name, cob_resolve_error (r));
      return 1;
   }
   if (setjmp (*(jmp_buf *)((char *)rtd + 0x40)) == 0) {
      (void)entry (eib, commarea);
   }
   cob_enterprise_set_current_region (rtd, 0);
   fflush (stdout);
   return 0;
}
]])

AT_DATA([host.c], [[
#include <stdio.h>
#include <dlfcn.h>

int
main (void)
{
   int (*run) (const char *);
   void *h = dlopen ("./method.so", RTLD_NOW | RTLD_LOCAL);
   if (h == NULL) {
      printf ("%s\n", dlerror ());
      return 1;
   }
   run = (int (*) (const char *))dlsym (h, "method_run");
   return run ("prog");
}
]])

AT_CHECK([$COMPILE_MODULE -std=txseries -o prog.cld prog.cob],
         [0], [], [])
AT_CHECK([$COBC -b -o method.so method.c \
          "$abs_top_srcdir/txseries/cobcld.c"], [0], [], [])
AT_CHECK([$COMPILE host.c -ldl], [0], [], [])
AT_CHECK([COB_LIBRARY_PATH=. ./host], [0],
[PROG DONE
], [])

AT_CLEANUP


AT_SETUP([runtime error: error procedure of TXSeries])
AT_KEYWORDS([runtxseries txseries cobcld CBL_ERROR_PROC])

# TXSeries installs its error procedure with CBL_ERROR_PROC (flag '0');
# a runtime error of a program calls it with the message (it abends the
# task), STOP RUN does not; both return to the jmp_buf of the rtd

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      PROG.
       DATA             DIVISION.
       LINKAGE          SECTION.
       01 DFHEIBLK      PIC X(8).
       01 DFHCOMMAREA   PIC X(4).
       PROCEDURE        DIVISION USING DFHEIBLK DFHCOMMAREA.
           DISPLAY "PROG " DFHCOMMAREA
           IF DFHCOMMAREA = "FAIL"
              CALL "notthere"
           END-IF
           STOP RUN.
])

AT_DATA([tx.c], [[
#include <stdio.h>
#include <string.h>
#include <setjmp.h>

typedef struct cob_rtd cob_rtd;
extern cob_rtd *cob_get_rtd (void);
extern void cob_init (cob_rtd *, int, char **);
extern cob_rtd *cob_enterprise_set_current_region (cob_rtd *, int);
extern void cob_enterprise_cancel_region (cob_rtd *, int, int);
extern void *cob_resolve (cob_rtd *, const char *);
extern int CBL_ERROR_PROC (unsigned char *, void *);

/* PinCA_CobolITErrorHandler */
static int
error_handler (char *msg)
{
   printf ("error procedure: %s\n", msg);
   return 0;
}

static void
run (const char *commarea_value)
{
   static char eib[8];
   char commarea[4];
   int (*entry) (char *, char *);
   cob_rtd *rtd = cob_get_rtd ();
   int ret;

   memcpy (commarea, commarea_value, 4);
   cob_enterprise_cancel_region (rtd, 1, 0);
   entry = (int (*) (char *, char *))
      cob_resolve (cob_enterprise_set_current_region (rtd, 1), "prog");
   ret = setjmp (*(jmp_buf *)((char *)rtd + 0x40));
   if (ret == 0) {
      (void)entry (eib, commarea);
      printf ("returned\n");
   } else {
      printf ("back to TXSeries with %d\n", ret);
   }
   cob_enterprise_set_current_region (rtd, 0);
   fflush (stdout);
}

int
main (void)
{
   unsigned char flag = '0';
   int (*proc) (char *) = error_handler;
   cob_rtd *rtd = cob_get_rtd ();

   /* PinCA_InitLang */
   (void)CBL_ERROR_PROC (&flag, &proc);
   *(int *)rtd = 1;
   cob_init (rtd, 0, NULL);

   run ("STOP");
   run ("FAIL");
   run ("STOP");
   return 0;
}
]])

AT_CHECK([$COMPILE_MODULE -o prog.cld prog.cob], [0], [], [])
AT_CHECK([$COBC -x -o tx tx.c "$abs_top_srcdir/txseries/cobcld.c"],
         [0], [], [])
AT_CHECK([COB_LIBRARY_PATH=. ./tx], [0],
[PROG STOP
back to TXSeries with 1
PROG FAIL
error procedure: prog.cob:11: module 'notthere' not found
back to TXSeries with -1
PROG STOP
back to TXSeries with 1
], [ignore])

AT_CLEANUP


AT_SETUP([unload of a module file])
AT_KEYWORDS([runtxseries txseries cob_unload_module NEWCOPY])

# a host (TXSeries for NEWCOPY) unloads a module file to load a new
# version of it; refused while other contexts exist

AT_DATA([v1.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      vers.
       PROCEDURE        DIVISION.
           DISPLAY "version 1"
           GOBACK.
])

AT_DATA([v2.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      vers.
       PROCEDURE        DIVISION.
           DISPLAY "version 2"
           GOBACK.
])

AT_DATA([host.c], [[
#include <stdio.h>
#include <libcob.h>

static void
call_vers (cob_context *ctx)
{
   int (*entry) (void);
   cob_context *prev = cob_context_enter (ctx);
   printf ("preload: %d\n", cob_preload_module_ctx (ctx, "./vers.cld"));
   entry = (int (*) (void))cob_resolve_ctx (ctx, "vers");
   fflush (stdout);
   (void)entry ();
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *main_ctx, *ctx;

   cob_set_hosted (1);
   cob_init (argc, argv);
   main_ctx = cob_get_current_context ();

   ctx = cob_context_create ();
   call_vers (ctx);
   printf ("unload with a context: %d\n",
           cob_unload_module_ctx (main_ctx, "./vers.cld"));
   cob_context_destroy (ctx);

   /* new version of the file */
   if (rename ("vers2.cld", "vers.cld") != 0) {
      perror ("rename");
   }
   ctx = cob_context_create ();
   call_vers (ctx);
   cob_context_destroy (ctx);

   printf ("unload: %d\n", cob_unload_module_ctx (main_ctx, "./vers.cld"));
   printf ("unload again: %d\n",
           cob_unload_module_ctx (main_ctx, "./vers.cld"));
   ctx = cob_context_create ();
   call_vers (ctx);
   cob_context_destroy (ctx);
   return 0;
}
]])

AT_CHECK([$COMPILE_MODULE -o vers.cld v1.cob], [0], [], [])
AT_CHECK([$COMPILE_MODULE -o vers2.cld v2.cob], [0], [], [])
AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[preload: 1
version 1
unload with a context: 0
preload: 1
version 1
unload: 1
unload again: 0
preload: 1
version 2
], [])

AT_CLEANUP


AT_SETUP([NEWCOPY of a program])
AT_KEYWORDS([runtxseries txseries cobcld NEWCOPY])

# a new version of a program is used after NEWCOPY (TXSeries cancels the
# regions 1 to 15 with the mode 1), or at each load with
# CICS_DISABLE_COBCLD_CACHE (mode 1 at each load), not before

AT_DATA([v1.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      VERS.
       DATA             DIVISION.
       LINKAGE          SECTION.
       01 DFHEIBLK      PIC X(8).
       01 DFHCOMMAREA   PIC X(4).
       PROCEDURE        DIVISION USING DFHEIBLK DFHCOMMAREA.
           DISPLAY "version 1"
           GOBACK.
])

AT_DATA([v2.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      VERS.
       DATA             DIVISION.
       LINKAGE          SECTION.
       01 DFHEIBLK      PIC X(8).
       01 DFHCOMMAREA   PIC X(4).
       PROCEDURE        DIVISION USING DFHEIBLK DFHCOMMAREA.
           DISPLAY "version 2"
           GOBACK.
])

AT_DATA([v3.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      VERS.
       DATA             DIVISION.
       LINKAGE          SECTION.
       01 DFHEIBLK      PIC X(8).
       01 DFHCOMMAREA   PIC X(4).
       PROCEDURE        DIVISION USING DFHEIBLK DFHCOMMAREA.
           DISPLAY "version 3"
           GOBACK.
])

AT_DATA([tx.c], [[
#include <stdio.h>
#include <stdlib.h>

typedef struct cob_rtd cob_rtd;
extern cob_rtd *cob_get_rtd (void);
extern void cob_init (cob_rtd *, int, char **);
extern cob_rtd *cob_enterprise_set_current_region (cob_rtd *, int);
extern int cob_enterprise_get_current_region (cob_rtd *);
extern void cob_enterprise_cancel_region (cob_rtd *, int, int);
extern void *cob_resolve (cob_rtd *, const char *);
extern char *cob_resolve_error (cob_rtd *);

static cob_rtd *rtd;

/* PinCA_LoadCOBCLD, PinCA_StartCOBCLD, PinCA_UnloadCOBCLD */
static void
run (int cancel_type)
{
   static char eib[8], commarea[4];
   int (*entry) (char *, char *);
   cob_rtd *r;

   cob_enterprise_cancel_region (rtd, 1, cancel_type);
   r = cob_enterprise_set_current_region (rtd, 1);
   entry = (int (*) (char *, char *))cob_resolve (r, "vers");
   if (entry == NULL) {
      printf ("%s\n", cob_resolve_error (r));
   } else {
      (void)entry (eib, commarea);
   }
   cob_enterprise_set_current_region (rtd, 0);
   fflush (stdout);
}

/* PinCA_COBCLDNewCopy */
static void
newcopy (void)
{
   int r;
   for (r = 1; r <= 15; r++) {
      cob_enterprise_cancel_region (rtd, r, 1);
   }
}

static void
install (const char *file)
{
   if (rename (file, "vers.cld") != 0) {
      perror ("rename");
   }
}

int
main (void)
{
   rtd = cob_get_rtd ();
   *(int *)rtd = 1;
   cob_init (rtd, 0, NULL);

   install ("vers1.cld");
   run (0);
   install ("vers2.cld");
   run (0);
   printf ("NEWCOPY\n");
   newcopy ();
   run (0);
   /* CICS_DISABLE_COBCLD_CACHE */
   install ("vers3.cld");
   run (1);
   return 0;
}
]])

AT_CHECK([$COMPILE_MODULE -o vers1.cld v1.cob], [0], [], [])
AT_CHECK([$COMPILE_MODULE -o vers2.cld v2.cob], [0], [], [])
AT_CHECK([$COMPILE_MODULE -o vers3.cld v3.cob], [0], [], [])
AT_CHECK([$COBC -x -o tx tx.c "$abs_top_srcdir/txseries/cobcld.c"],
         [0], [], [])
AT_CHECK([COB_LIBRARY_PATH=. ./tx], [0],
[version 1
version 1
NEWCOPY
version 2
version 3
], [])

AT_CLEANUP
