AT_SETUP([COBOL to C to COBOL in several execution contexts])
AT_KEYWORDS([runreentrant cob_context_create CALL cob_call])

# a COBOL program calls a C function, which calls back a COBOL program
# with cob_call: the callee runs in the current context of the caller
# (its WORKING-STORAGE is the one of that context)

AT_DATA([proga.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      proga.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9(4) VALUE 0.
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       PROCEDURE        DIVISION USING TAG.
           ADD 1 TO CNT
           DISPLAY TAG " proga: " CNT
           CALL "cfunc" USING TAG
           GOBACK.
])

AT_DATA([progb.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      progb.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9(4) VALUE 0.
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       PROCEDURE        DIVISION USING TAG.
           ADD 10 TO CNT
           DISPLAY TAG " progb: " CNT
           GOBACK.
])

AT_DATA([cfunc.c], [[
#include <libcob.h>

COB_EXT_EXPORT int
cfunc (char *tag)
{
   void *argv[1];
   argv[0] = tag;
   return cob_call ("progb", 1, argv);
}
]])

AT_DATA([host.c], [[
#include <libcob.h>

static void
call_proga (cob_context *ctx, const char *tag)
{
   void *argv[1];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   (void)cob_call ("proga", 1, argv);
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *main_ctx, *ctx2;

   cob_init (argc, argv);
   main_ctx = cob_get_current_context ();
   ctx2 = cob_context_create ();

   call_proga (main_ctx, "main");
   call_proga (ctx2, "ctx2");
   call_proga (main_ctx, "main");
   call_proga (ctx2, "ctx2");

   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

