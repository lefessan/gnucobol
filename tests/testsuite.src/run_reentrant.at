AT_SETUP([current directory of the execution contexts])
AT_KEYWORDS([runreentrant cob_context_create CBL_CHANGE_DIR CBL_CREATE_DIR])

# while other contexts exist, CBL_CHANGE_DIR only changes the current
# directory of the context: the relative names of its files and
# directories, and its child processes, use it; the directory of the
# process is not changed

AT_DATA([cd.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      cd.
       ENVIRONMENT      DIVISION.
       CONFIGURATION    SECTION.
       SPECIAL-NAMES.
           PRINTER IS PRT.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO "out.txt"
                  ORGANIZATION LINE SEQUENTIAL.
           SELECT PIPE-OUT ASSIGN TO PCMD
                  ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD OUT-FILE.
       01 OUT-REC       PIC X(4).
       FD PIPE-OUT.
       01 PIPE-REC      PIC X(4).
       WORKING-STORAGE  SECTION.
       01 RC            PIC S9(9) BINARY.
       01 PCMD          PIC X(30) VALUE "> cat > piped.txt".
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       01 DIR           PIC X(2).
       PROCEDURE        DIVISION USING TAG DIR.
           IF DIR NOT = SPACES
              CALL "CBL_CHANGE_DIR" USING DIR RETURNING RC
              DISPLAY TAG " CBL_CHANGE_DIR: " RC
              CALL "CBL_CREATE_DIR" USING "sub" RETURNING RC
              DISPLAY TAG " CBL_CREATE_DIR: " RC
           END-IF
           OPEN OUTPUT OUT-FILE
           MOVE TAG TO OUT-REC
           WRITE OUT-REC
           CLOSE OUT-FILE
           OPEN OUTPUT PIPE-OUT
           MOVE TAG TO PIPE-REC
           WRITE PIPE-REC
           CLOSE PIPE-OUT
           CALL "SYSTEM" USING "echo sys > where.txt"
           DISPLAY TAG UPON PRT
           GOBACK.
])

AT_DATA([host.c], [[
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <libcob.h>

static void
cd (cob_context *ctx, const char *tag, const char *dir)
{
   void *argv[2];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   argv[1] = (void *)dir;
   (void)cob_call ("cd", 2, argv);
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *main_ctx, *ctx1, *ctx2;
   char before[4096], after[4096];

   cob_init (argc, argv);
   main_ctx = cob_get_current_context ();
   ctx1 = cob_context_create ();
   ctx2 = cob_context_create ();

   (void)getcwd (before, sizeof (before));
   cd (ctx1, "ctx1", "d1");
   cd (ctx2, "ctx2", "d2");
   cd (ctx1, "ctx1", "  ");
   cd (main_ctx, "main", "  ");
   (void)getcwd (after, sizeof (after));
   printf ("process directory unchanged: %d\n", strcmp (before, after) == 0);

   cob_context_destroy (ctx1);
   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

