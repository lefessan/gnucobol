AT_SETUP([INDEXED files in several threads])
AT_KEYWORDS([runreentrant cob_context_create INDEXED thread])

AT_SKIP_IF([test "$COB_HAS_ISAM" = "no"])

# each thread creates its own execution context and writes then reads
# its own INDEXED file (with an alternate key); the first OPEN of the
# threads loads the I/O routine and joins the environment of the
# backend concurrently

AT_DATA([calc.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      calc.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT I ASSIGN TO INAME ORGANIZATION INDEXED
                  ACCESS DYNAMIC RECORD KEY IK
                  ALTERNATE RECORD KEY IA WITH DUPLICATES.
       DATA             DIVISION.
       FILE             SECTION.
       FD I.
       01 IR.
          05 IK         PIC 9(8).
          05 IA         PIC 9(2).
          05 IDT        PIC X(20).
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9(8) VALUE 0.
       01 INAME         PIC X(30).
       LINKAGE          SECTION.
       01 RES           PIC 9(8).
       01 TID           PIC 9(2).
       PROCEDURE        DIVISION USING RES TID.
           IF CNT = 0
              STRING "i" TID ".dat" DELIMITED SIZE INTO INAME
              OPEN OUTPUT I
              CLOSE I
              OPEN I-O I
           END-IF
           ADD 1 TO CNT
           MOVE CNT TO IK
           MOVE FUNCTION MOD (CNT 7) TO IA
           MOVE "data" TO IDT
           WRITE IR
           MOVE CNT TO IK
           READ I KEY IS IK
           IF IK NOT = CNT
              MOVE 0 TO CNT
           END-IF
           MOVE CNT TO RES
           GOBACK.
])

AT_DATA([mt.c], [[
