AT_CHECK([ODBCSYSINI=$PWD ODBCINI=$PWD/odbc.ini COB_SCHEMA_DIR=$PWD/schema \
          IX_OPTIONS=format=odbc $COBCRUN_DIRECT ./mt], [0],
[thread 0: 0 bad
thread 1: 0 bad
thread 2: 0 bad
thread 3: 0 bad
thread 4: 0 bad
thread 5: 0 bad
thread 6: 0 bad
thread 7: 0 bad
], [])

