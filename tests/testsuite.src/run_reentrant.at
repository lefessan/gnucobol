AT_SETUP([runtime settings of the execution contexts])
AT_KEYWORDS([runreentrant cob_context_create COB_LS_FIXED ENVIRONMENT-VALUE])

# a runtime setting set in the environment of a context (while other
# contexts exist) only applies to this context: here COB_LS_FIXED keeps
# the trailing spaces of the LINE SEQUENTIAL records; emptying the
# variable gives back the setting of the process

AT_DATA([ls.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      ls.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO FNAME
                  ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD OUT-FILE.
       01 OUT-REC       PIC X(5).
       WORKING-STORAGE  SECTION.
       01 FNAME         PIC X(12).
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       01 OP            PIC X.
       PROCEDURE        DIVISION USING TAG OP.
           IF OP = "S"
              DISPLAY "COB_LS_FIXED" UPON ENVIRONMENT-NAME
              DISPLAY "TRUE" UPON ENVIRONMENT-VALUE
           END-IF
           IF OP = "U"
              DISPLAY "COB_LS_FIXED" UPON ENVIRONMENT-NAME
              DISPLAY " " UPON ENVIRONMENT-VALUE
           END-IF
           STRING TAG OP ".txt" DELIMITED SIZE INTO FNAME
           OPEN OUTPUT OUT-FILE
           MOVE "ab" TO OUT-REC
           WRITE OUT-REC
           CLOSE OUT-FILE
           GOBACK.
])

