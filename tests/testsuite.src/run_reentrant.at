### GnuCOBOL Test Suite

## Reentrant runtime: several execution contexts in one process,
## possibly in several threads (see TXSERIES-T1-DESIGN.md)

AT_SETUP([CALL in from C, several execution contexts])
AT_KEYWORDS([runreentrant cob_context_create cob_context_destroy cob_context_enter reentrant])

# each context has its own instances of the programs (WORKING-STORAGE,
# files) and its own run unit (EXTERNAL items); destroying a context
# closes its open files

AT_DATA([counter.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      counter.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO FNAME
                  ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD OUT-FILE.
       01 OUT-REC       PIC X(4).
       WORKING-STORAGE  SECTION.
       01 FNAME         PIC X(20).
       01 CNT           PIC 9(4) VALUE 0.
       01 X             PIC S9(20)V9(5) VALUE 1.
       01 EXT-CNT       PIC 9(4) EXTERNAL.
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       PROCEDURE        DIVISION USING TAG.
           IF CNT = 0
              STRING "out-" TAG ".txt" DELIMITED SIZE INTO FNAME
              OPEN OUTPUT OUT-FILE
           END-IF
           IF EXT-CNT NOT NUMERIC
              MOVE 0 TO EXT-CNT
           END-IF
           ADD 1 TO CNT EXT-CNT
           COMPUTE X = X * 3 / 7 + FUNCTION PI
           MOVE TAG TO OUT-REC
           WRITE OUT-REC
           DISPLAY TAG ": " CNT " " EXT-CNT
           GOBACK.
])

AT_DATA([host.c], [[
#include <libcob.h>

static void
call_counter (const char *tag)
{
   void *argv[1];
   argv[0] = (void *)tag;
   (void)cob_call ("counter", 1, argv);
}

int
main (int argc, char **argv)
{
   cob_context *ctx2, *ctx3, *prev;

   cob_init (argc, argv);

   call_counter ("main");
   call_counter ("main");

   ctx2 = cob_context_create ();
   prev = cob_context_enter (ctx2);
   call_counter ("ctx2");
   cob_context_leave (prev);

   call_counter ("main");

   prev = cob_context_enter (ctx2);
   call_counter ("ctx2");
   cob_context_leave (prev);
   cob_context_destroy (ctx2);

   ctx3 = cob_context_create ();
   prev = cob_context_enter (ctx3);
   call_counter ("ctx3");
   cob_context_leave (prev);
   cob_context_destroy (ctx3);

   call_counter ("main");

   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE counter.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[main: 0001 0001
main: 0002 0002
ctx2: 0001 0001
main: 0003 0003
ctx2: 0002 0002
ctx3: 0001 0001
main: 0004 0004
], [libcob: counter.cob:33: warning: implicit CLOSE of OUT-FILE ('out-main.txt')
])
AT_CHECK([cat out-ctx2.txt out-ctx3.txt], [0],
[ctx2
ctx2
ctx3
], [])

AT_CLEANUP


AT_SETUP([CALL in from C, execution contexts in several threads])
AT_KEYWORDS([runreentrant cob_context_create cob_context_destroy cob_context_enter reentrant thread])

# each thread creates its own execution context and calls the same
# program many times; the WORKING-STORAGE and the files of the program
# must be private to each context (arithmetic, intrinsic functions,
# STRING / INSPECT and LINE SEQUENTIAL files are exercised)

AT_DATA([calc.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      calc.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT F ASSIGN TO FNAME ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD F.
       01 FR            PIC X(40).
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9(8) VALUE 0.
       01 X             PIC S9(20)V9(5) VALUE 0.
       01 S             PIC X(40).
       01 FNAME         PIC X(30).
       01 D             PIC X(21).
       LINKAGE          SECTION.
       01 RES           PIC 9(8).
       01 TID           PIC 9(2).
       PROCEDURE        DIVISION USING RES TID.
           IF CNT = 0
              STRING "f" TID ".txt" DELIMITED SIZE INTO FNAME
              OPEN OUTPUT F
           END-IF
           ADD 1 TO CNT
           COMPUTE X = (CNT * 3) / 7 + FUNCTION SQRT (CNT * CNT)
           MOVE FUNCTION CURRENT-DATE TO D
           MOVE SPACES TO S
           STRING "v" CNT " " X DELIMITED SIZE INTO S
           INSPECT S REPLACING ALL "0" BY "o"
           MOVE S TO FR
           WRITE FR
           MOVE CNT TO RES
           GOBACK.
])

AT_DATA([mt.c], [[
#include <stdio.h>
#include <string.h>
#include <pthread.h>
#include <libcob.h>

#define NTHREADS 8
#define NCALLS 1000

static int bads[NTHREADS];

static void *
task (void *arg)
{
   int *bad = (int *)arg;
   cob_context *ctx = cob_context_create ();
   cob_context *prev = cob_context_enter (ctx);
   char res[9] = "00000000";
   char tid[3];
   void *argv[2];
   int i;

   snprintf (tid, sizeof tid, "%02d", (int)(bad - bads));
   argv[0] = res;
   argv[1] = tid;
   for (i = 1; i <= NCALLS; i++) {
      char expected[9];
      (void)cob_call ("calc", 2, argv);
      snprintf (expected, sizeof expected, "%08d", i);
      if (memcmp (res, expected, 8)) {
         (*bad)++;
      }
   }
   cob_context_leave (prev);
   cob_context_destroy (ctx);
   return NULL;
}

int
main (int argc, char **argv)
{
   pthread_t th[NTHREADS];
   int i;

   cob_init (argc, argv);
   /* the module is loaded by the first CALL, in one of the threads */
   for (i = 0; i < NTHREADS; i++) {
      pthread_create (&th[i], NULL, task, &bads[i]);
   }
   for (i = 0; i < NTHREADS; i++) {
      pthread_join (th[i], NULL);
      printf ("thread %d: %d bad\n", i, bads[i]);
   }
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE mt.c -lpthread || exit 77], [0], [], [])
AT_CHECK([$COMPILE_MODULE calc.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./mt], [0],
[thread 0: 0 bad
thread 1: 0 bad
thread 2: 0 bad
thread 3: 0 bad
thread 4: 0 bad
thread 5: 0 bad
thread 6: 0 bad
thread 7: 0 bad
], [])
AT_CHECK([wc -l < f00.txt], [0], [1000
], [])
AT_CHECK([tail -1 f00.txt], [0], [voooo1ooo oooooooooooooooo142857142
], [])
AT_CHECK([for i in 01 02 03 04 05 06 07; do cmp f00.txt f$i.txt || exit 1; done], [0], [], [])

AT_CLEANUP


AT_SETUP([CANCEL in one execution context])
AT_KEYWORDS([runreentrant cob_context_create cob_cancel CANCEL])

# CANCEL acts on the instance of the program in the current context
# only: the WORKING-STORAGE of the other contexts is kept

AT_DATA([counter.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      counter.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9(4) VALUE 0.
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       PROCEDURE        DIVISION USING TAG.
           ADD 1 TO CNT
           DISPLAY TAG ": " CNT
           GOBACK.
])

AT_DATA([canceller.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      canceller.
       PROCEDURE        DIVISION.
           CANCEL "counter"
           GOBACK.
])

AT_DATA([host.c], [[
#include <libcob.h>

static void
call_counter (cob_context *ctx, const char *tag)
{
   void *argv[1];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   (void)cob_call ("counter", 1, argv);
   cob_context_leave (prev);
}

static void
cancel_counter (cob_context *ctx, int from_cobol)
{
   cob_context *prev = cob_context_enter (ctx);
   if (from_cobol) {
      (void)cob_call ("canceller", 0, NULL);
   } else {
      cob_cancel ("counter");
   }
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *main_ctx, *ctx2;

   cob_init (argc, argv);
   main_ctx = cob_get_current_context ();
   ctx2 = cob_context_create ();

   call_counter (main_ctx, "main");
   call_counter (main_ctx, "main");
   call_counter (ctx2, "ctx2");
   call_counter (ctx2, "ctx2");

   /* two CANCELs in a row, in two contexts */
   cancel_counter (ctx2, 0);
   call_counter (main_ctx, "main");
   cancel_counter (main_ctx, 1);
   call_counter (main_ctx, "main");
   call_counter (ctx2, "ctx2");
   call_counter (main_ctx, "main");

   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE counter.cob], [0], [], [])
AT_CHECK([$COMPILE_MODULE canceller.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[main: 0001
main: 0002
ctx2: 0001
ctx2: 0002
main: 0003
main: 0001
ctx2: 0001
main: 0002
], [])

AT_CLEANUP


AT_SETUP([record locks of INDEXED files between execution contexts])
AT_KEYWORDS([runreentrant cob_context_create INDEXED LOCK])

AT_SKIP_IF([test "$COB_HAS_ISAM" = "no"])

# each context has its own record locks: a record locked in a context
# cannot be locked in another one until it is released

AT_DATA([lk.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      lk.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT IX ASSIGN TO "ixfile"
                  ORGANIZATION INDEXED ACCESS DYNAMIC
                  RECORD KEY IK
                  LOCK MODE MANUAL
                  SHARING WITH ALL OTHER
                  STATUS FS.
       DATA             DIVISION.
       FILE             SECTION.
       FD IX.
       01 IR.
          05 IK         PIC X(4).
          05 IDATA      PIC X(10).
       WORKING-STORAGE  SECTION.
       01 FS            PIC XX.
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       01 OP            PIC X.
       PROCEDURE        DIVISION USING TAG OP.
           EVALUATE OP
           WHEN "W"
              OPEN OUTPUT IX
              MOVE "K001" TO IK
              MOVE "data" TO IDATA
              WRITE IR
              CLOSE IX
           WHEN "O"
              OPEN I-O IX
           WHEN "R"
              MOVE "K001" TO IK
              READ IX WITH LOCK
           WHEN "U"
              UNLOCK IX
           WHEN "C"
              CLOSE IX
           END-EVALUATE
           DISPLAY TAG " " OP ": " FS
           GOBACK.
])

AT_DATA([host.c], [[
#include <libcob.h>

static void
lk (cob_context *ctx, const char *tag, const char *op)
{
   void *argv[2];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   argv[1] = (void *)op;
   (void)cob_call ("lk", 2, argv);
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *ctx1, *ctx2;

   cob_init (argc, argv);
   ctx1 = cob_context_create ();
   ctx2 = cob_context_create ();

   lk (ctx1, "ctx1", "W");
   lk (ctx1, "ctx1", "O");
   lk (ctx2, "ctx2", "O");
   lk (ctx1, "ctx1", "R");
   lk (ctx2, "ctx2", "R");   /* locked by ctx1 */
   lk (ctx1, "ctx1", "U");
   lk (ctx2, "ctx2", "R");
   lk (ctx1, "ctx1", "R");   /* locked by ctx2 */
   lk (ctx2, "ctx2", "C");
   lk (ctx1, "ctx1", "R");
   lk (ctx1, "ctx1", "C");

   cob_context_destroy (ctx1);
   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE lk.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[ctx1 W: 00
ctx1 O: 00
ctx2 O: 00
ctx1 R: 00
ctx2 R: 51
ctx1 U: 00
ctx2 R: 00
ctx1 R: 51
ctx2 C: 00
ctx1 R: 00
ctx1 C: 00
], [])

AT_CLEANUP


AT_SETUP([no mutable static data in the generated code])
AT_KEYWORDS([runreentrant static])

# all the mutable data of the programs lives in the instance of the
# compilation unit, allocated in each context; the only static data
# left are shared by the contexts:
# - cob_unit_slot: slot of the compilation unit, set once
# - cob_module_path, cob_reference_count: process-level data of the
#   module (dlclose)
# - call_X / func_X: caches of the resolution of dynamic CALLs

AT_CHECK([objdump --version >/dev/null 2>&1 || exit 77])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       ENVIRONMENT      DIVISION.
       CONFIGURATION    SECTION.
       SPECIAL-NAMES.
           ALPHABET ALPHA-CUSTOM IS "A" THRU "Z", "0" THRU "9".
           ALPHABET ALPHA-NATIVE IS NATIVE.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT F ASSIGN TO "f.txt" ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD F.
       01 FR            PIC X(10).
       WORKING-STORAGE  SECTION.
       01 X             PIC 9(4) VALUE 0.
       01 Y             PIC S9(20)V9(5) VALUE 1.
       01 S             PIC X(10).
       01 P             USAGE POINTER.
       01 E             PIC X(4) EXTERNAL.
       01 B             PIC X(10) BASED.
       LINKAGE          SECTION.
       01 L             PIC X(10).
       PROCEDURE        DIVISION USING L.
           ADD 1 TO X
           COMPUTE Y = Y * 3 / 7 + FUNCTION PI
           MOVE "abc" TO S
           INSPECT S CONVERTING "abc" TO "ABC"
           INSPECT S CONVERTING ALPHA-CUSTOM TO ALPHA-NATIVE
           CALL "sub" USING S
           CALL "nested" USING S
           OPEN OUTPUT F
           CLOSE F
           GOBACK.

       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      nested.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 Z             PIC 9(4) VALUE 0.
       LINKAGE          SECTION.
       01 L             PIC X(10).
       PROCEDURE        DIVISION USING L.
           ADD 1 TO Z
           GOBACK.
       END PROGRAM nested.
       END PROGRAM prog.
])

AT_CHECK([$COBC -c ${FLAGS} prog.cob], [0], [], [])
AT_CHECK([$SHELL "$abs_top_srcdir/build_aux/list-mutable-globals.sh" prog.o \
          | cut -f5 | sed -e 's/\.[[0-9]]*$//' \
          | $GREP -v -E '^(cob_unit_slot|cob_module_path|cob_reference_count|call_.*|func_.*)$'],
         [1], [], [])

AT_CLEANUP

