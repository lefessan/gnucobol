AT_SETUP([STOP RUN and fatal errors in an execution context])
AT_KEYWORDS([runreentrant cob_context_create cob_call_with_exception_check STOP])

# called with cob_call_with_exception_check_ctx in a context other than
# the main one, STOP RUN and fatal errors end the run unit of the context
# (files closed), call the end handler of the host and return to the
# host; the process and the other contexts go on

AT_DATA([sr.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      sr.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO "sr.txt"
                  ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD OUT-FILE.
       01 OUT-REC       PIC X(4).
       WORKING-STORAGE  SECTION.
       01 MISSING       PIC X(10) VALUE "nosuchprog".
       LINKAGE          SECTION.
       01 OP            PIC X.
       PROCEDURE        DIVISION USING OP.
           EVALUATE OP
           WHEN "S"
              OPEN OUTPUT OUT-FILE
              MOVE "stop" TO OUT-REC
              WRITE OUT-REC
              MOVE 7 TO RETURN-CODE
              STOP RUN
           WHEN "E"
              CALL MISSING
           END-EVALUATE
           DISPLAY "sr " OP ": back"
           GOBACK.
])

AT_DATA([host.c], [[
#include <stdio.h>
#include <libcob.h>

static void
end_handler (cob_context *ctx, int ret, int exit_code, const char *msg,
             void *data)
{
   printf ("end handler %s: %d, exit code %d, \"%s\"\n",
           (const char *)data, ret, exit_code, msg);
   fflush (stdout);
}

static void
sr (cob_context *ctx, const char *op)
{
   void *argv[1];
   int ret;
   cob_context *prev = cob_context_enter (ctx);
   cob_context_set_end_handler (ctx, end_handler, (void *)op);
   argv[0] = (void *)op;
   ret = cob_call_with_exception_check_ctx (ctx, "sr", 1, argv);
   cob_context_leave (prev);
   printf ("%s: return %d, exit code %d\n", op, ret,
           cob_last_exit_code_ctx (ctx));
   fflush (stdout);
}

int
main (int argc, char **argv)
{
   cob_context *ctx;

   cob_init (argc, argv);

   ctx = cob_context_create ();
   sr (ctx, "S");
   cob_context_destroy (ctx);

   ctx = cob_context_create ();
   sr (ctx, "E");
   cob_context_destroy (ctx);

   ctx = cob_context_create ();
   sr (ctx, "N");
   cob_context_destroy (ctx);

   printf ("host goes on\n");
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE sr.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[end handler S: 1, exit code 7, ""
S: return 1, exit code 7
end handler E: -1, exit code -1, "sr.cob:26: module 'nosuchprog' not found"
E: return -1, exit code -1
sr N: back
N: return 0, exit code 0
host goes on
], [libcob: sr.cob:26: error: module 'nosuchprog' not found
])
AT_CHECK([cat sr.txt], [0],
[stop
], [])

AT_CLEANUP


AT_SETUP([exit and error procedures of the execution contexts])
AT_KEYWORDS([runreentrant cob_context_create CBL_EXIT_PROC CBL_ERROR_PROC])

# the procedures installed with CBL_EXIT_PROC and CBL_ERROR_PROC belong
# to the run unit of the context: the exit procedures run at the end of
# the run unit of their context (STOP RUN, destruction), the error
# procedures for the errors of their context

AT_DATA([ep.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      ep.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 EXIT-ADDR     USAGE PROCEDURE-POINTER.
       01 ERR-ADDR      USAGE PROGRAM-POINTER.
       01 MISSING       PIC X(10) VALUE "nosuchprog".
       LINKAGE          SECTION.
       01 OP            PIC X.
       PROCEDURE        DIVISION USING OP.
           EVALUATE OP
           WHEN "I"
              SET EXIT-ADDR TO ENTRY "bye"
              CALL "CBL_EXIT_PROC" USING 0, EXIT-ADDR
              SET ERR-ADDR TO ENTRY "errp"
              CALL "CBL_ERROR_PROC" USING 0, ERR-ADDR
           WHEN "S"
              STOP RUN
           WHEN "E"
              CALL MISSING
           END-EVALUATE
           GOBACK.
       END PROGRAM ep.

       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      bye.
       PROCEDURE        DIVISION.
           DISPLAY "exit procedure"
           GOBACK.
       END PROGRAM bye.

       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      errp.
       PROCEDURE        DIVISION.
           DISPLAY "error procedure"
           MOVE 1 TO RETURN-CODE
           GOBACK.
       END PROGRAM errp.
])

AT_DATA([host.c], [[
#include <stdio.h>
#include <libcob.h>

static int
ep (cob_context *ctx, const char *op)
{
   void *argv[1];
   int ret;
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)op;
   ret = cob_call_with_exception_check_ctx (ctx, "ep", 1, argv);
   cob_context_leave (prev);
   return ret;
}

int
main (int argc, char **argv)
{
   cob_context *ctx1, *ctx2;

   cob_init (argc, argv);

   /* STOP RUN */
   ctx1 = cob_context_create ();
   ctx2 = cob_context_create ();
   ep (ctx1, "I");
   printf ("ctx2 stop: %d\n", ep (ctx2, "S"));
   fflush (stdout);
   printf ("ctx1 stop: %d\n", ep (ctx1, "S"));
   fflush (stdout);
   cob_context_destroy (ctx1);
   cob_context_destroy (ctx2);

   /* errors, end by destruction */
   ctx1 = cob_context_create ();
   ctx2 = cob_context_create ();
   ep (ctx1, "I");
   printf ("ctx2 error: %d\n", ep (ctx2, "E"));
   fflush (stdout);
   printf ("ctx1 error: %d\n", ep (ctx1, "E"));
   fflush (stdout);
   cob_context_destroy (ctx2);
   ctx2 = cob_context_create ();
   ep (ctx2, "I");
   printf ("destroy ctx2\n");
   fflush (stdout);
   cob_context_destroy (ctx2);
   cob_context_destroy (ctx1);
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE ep.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[ctx2 stop: 1
exit procedure
ctx1 stop: 1
ctx2 error: -1
error procedure
exit procedure
ctx1 error: -1
destroy ctx2
exit procedure
], [libcob: ep.cob:21: error: module 'nosuchprog' not found
libcob: ep.cob:21: error: module 'nosuchprog' not found
])

AT_CLEANUP


AT_SETUP([hosted runtime: no signal handlers])
AT_KEYWORDS([runreentrant cob_set_hosted signal])

# a hosted runtime (cob_set_hosted before cob_init) installs no signal
# handler, the host keeps its own

AT_DATA([host.c], [[
#include <stdio.h>
#include <string.h>
#include <signal.h>
#include <libcob.h>

int
main (int argc, char **argv)
{
   struct sigaction sa;
   const int hosted = argc > 1 && strcmp (argv[1], "hosted") == 0;

   cob_set_hosted (hosted);
   cob_init (0, NULL);
   sigaction (SIGSEGV, NULL, &sa);
   printf ("hosted %d, SIGSEGV handler: %s\n", cob_is_hosted (),
           sa.sa_handler == SIG_DFL ? "default" : "libcob");
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host hosted], [0],
[hosted 1, SIGSEGV handler: default
], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[hosted 0, SIGSEGV handler: libcob
], [])

AT_CLEANUP


AT_SETUP([hosted runtime: STOP RUN in the main context])
AT_KEYWORDS([runreentrant cob_set_hosted cob_call_with_exception_check STOP])

# in a hosted runtime, the main context is a task as the others: its
# STOP RUN ends its run unit and returns to the host, the runtime goes on;
# the next run unit starts with the programs in their initial state

AT_DATA([st.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      st.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT OPTIONAL OUT-FILE ASSIGN TO "st.txt"
                  ORGANIZATION LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD OUT-FILE.
       01 OUT-REC       PIC X(4).
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9 VALUE 0.
       PROCEDURE        DIVISION.
           ADD 1 TO CNT
           OPEN EXTEND OUT-FILE
           MOVE "run" TO OUT-REC
           WRITE OUT-REC
           MOVE CNT TO RETURN-CODE
           STOP RUN.
])

AT_DATA([host.c], [[
#include <stdio.h>
#include <libcob.h>

int
main (int argc, char **argv)
{
   cob_context *ctx;
   int i, ret;

   cob_set_hosted (1);
   cob_init (argc, argv);
   ctx = cob_get_current_context ();
   for (i = 0; i < 2; i++) {
      ret = cob_call_with_exception_check_ctx (ctx, "st", 0, NULL);
      printf ("return %d, exit code %d\n", ret, cob_last_exit_code_ctx (ctx));
   }
   printf ("host goes on\n");
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE st.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[return 1, exit code 1
return 1, exit code 1
host goes on
], [])
AT_CHECK([cat st.txt], [0],
[run
run
], [])

AT_CLEANUP


AT_SETUP([hosted runtime: console input and screen I/O])
AT_KEYWORDS([runreentrant cob_set_hosted ACCEPT screen])

# a hosted runtime (server) does not read its standard input: ACCEPT
# gives spaces and EC-IMP-ACCEPT; screen I/O is a runtime error, which
# returns to the host

AT_CHECK([test "$COB_HAS_CURSES" = "yes" || exit 77])

AT_DATA([ac.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      ac.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 X             PIC X(4) VALUE "init".
       LINKAGE          SECTION.
       01 OP            PIC X.
       PROCEDURE        DIVISION USING OP.
           IF OP = "A"
              ACCEPT X
              DISPLAY "accept: <" X "> "
                      FUNCTION TRIM (FUNCTION EXCEPTION-STATUS)
           ELSE
              DISPLAY "screen" AT 0101
           END-IF
           GOBACK.
])

AT_DATA([host.c], [[
#include <stdio.h>
#include <libcob.h>

int
main (int argc, char **argv)
{
   cob_context *ctx;
   void *a[1];
   int ret;

   cob_set_hosted (1);
   cob_init (argc, argv);
   ctx = cob_context_create ();
   (void)cob_context_enter (ctx);
   a[0] = "A";
   ret = cob_call_with_exception_check_ctx (ctx, "ac", 1, a);
   printf ("accept: return %d\n", ret);
   a[0] = "S";
   ret = cob_call_with_exception_check_ctx (ctx, "ac", 1, a);
   printf ("screen: return %d\n", ret);
   cob_context_destroy (ctx);
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE ac.cob], [0], [], [])
AT_CHECK([echo data | $COBCRUN_DIRECT ./host], [0],
[accept: <    > EC-IMP-ACCEPT
accept: return 0
screen: return -1
], [libcob: ac.cob:15: error: screen I/O is not available in a hosted runtime
])

AT_CLEANUP


AT_SETUP([hosted runtime: CBL_GC_FORK])
AT_KEYWORDS([runreentrant cob_set_hosted CBL_GC_FORK])

# a hosted runtime (server with other threads) is not duplicated

AT_DATA([fk.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      fk.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 R             PIC S9(9) BINARY.
       PROCEDURE        DIVISION.
           CALL "CBL_GC_FORK" RETURNING R
           DISPLAY "fork: " R
           GOBACK.
])

AT_DATA([host.c], [[
#include <libcob.h>

int
main (int argc, char **argv)
{
   cob_context *ctx;
   cob_set_hosted (1);
   cob_init (argc, argv);
   ctx = cob_context_create ();
   (void)cob_context_enter (ctx);
   (void)cob_call_with_exception_check_ctx (ctx, "fk", 0, NULL);
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
