])

AT_DATA([host.c], [[
#include <libcob.h>

static void
trc (cob_context *ctx, const char *tag, const char *op)
{
   void *argv[2];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   argv[1] = (void *)op;
   (void)cob_call ("trc", 2, argv);
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *ctx1, *ctx2;

   cob_init (argc, argv);
   ctx1 = cob_context_create ();
   ctx2 = cob_context_create ();

   trc (ctx1, "ctx1", "R");
   trc (ctx2, "ctx2", "N");
   trc (ctx1, "ctx1", "N");
   trc (ctx1, "ctx1", "X");
   trc (ctx1, "ctx1", "N");

   cob_context_destroy (ctx1);
   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

