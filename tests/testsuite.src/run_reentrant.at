AT_CHECK([$COMPILE_MODULE rl.cob], [0], [], [])
AT_CHECK([$COMPILE other.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[ctx1 W: 00
ctx1 O: 00
ctx2 O: 00
ctx1 R: 00
ctx2 R: 51
ctx1 C: 00
ctx1 O: 00
ctx2 R: 00
ctx1 R: 51
ctx1 C: 00
proc R: 51
ctx2 C: 00
proc R: 00
ctx1 X: 00
ctx2 X: 61
ctx1 Y: 00
ctx2 X: 00
ctx2 Y: 00
], [])

AT_CLEANUP


AT_SETUP([UNLOCK of the record locks of a RELATIVE file])
AT_KEYWORDS([runreentrant cob_context_create RELATIVE LOCK UNLOCK])

# UNLOCK releases the record locks of the file connector, for the other
# contexts and for the other processes; the lock of another context on
# the same file is kept

AT_DATA([ul.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      ul.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT RELF ASSIGN TO "relfile"
                  ORGANIZATION RELATIVE ACCESS RANDOM
                  RELATIVE KEY RK
                  LOCK MODE MANUAL
                  SHARING WITH ALL OTHER
                  STATUS FS.
       DATA             DIVISION.
       FILE             SECTION.
       FD RELF.
       01 RR            PIC X(10).
       WORKING-STORAGE  SECTION.
       01 FS            PIC XX.
       01 RK            PIC 9(4).
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       01 OP            PIC X.
       01 REC           PIC 9.
       PROCEDURE        DIVISION USING TAG OP REC.
           MOVE REC TO RK
           EVALUATE OP
           WHEN "W"
              OPEN OUTPUT RELF
              MOVE "data" TO RR
              WRITE RR
              MOVE 2 TO RK
              WRITE RR
              CLOSE RELF
           WHEN "O"
              OPEN I-O RELF
           WHEN "R"
              READ RELF WITH LOCK
           WHEN "U"
              UNLOCK RELF
           WHEN "C"
              CLOSE RELF
           END-EVALUATE
           DISPLAY TAG " " OP " " REC ": " FS
           GOBACK.
])

AT_DATA([other.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      other.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT RELF ASSIGN TO "relfile"
                  ORGANIZATION RELATIVE ACCESS RANDOM
                  RELATIVE KEY RK
                  LOCK MODE MANUAL
                  SHARING WITH ALL OTHER
                  STATUS FS.
       DATA             DIVISION.
       FILE             SECTION.
       FD RELF.
       01 RR            PIC X(10).
       WORKING-STORAGE  SECTION.
       01 FS            PIC XX.
       01 RK            PIC 9(4).
       PROCEDURE        DIVISION.
           OPEN I-O RELF
           MOVE 1 TO RK
           READ RELF WITH LOCK
           DISPLAY "proc R 1: " FS
           MOVE 2 TO RK
           READ RELF WITH LOCK
           DISPLAY "proc R 2: " FS
           CLOSE RELF
           STOP RUN.
])

AT_DATA([host.c], [[
#include <stdio.h>
#include <stdlib.h>
#include <libcob.h>

static void
ul (cob_context *ctx, const char *tag, const char *op, const char *rec)
{
   void *argv[3];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   argv[1] = (void *)op;
   argv[2] = (void *)rec;
   (void)cob_call ("ul", 3, argv);
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *ctx1, *ctx2;

   cob_init (argc, argv);
   ctx1 = cob_context_create ();
   ctx2 = cob_context_create ();

   ul (ctx1, "ctx1", "W", "1");
   ul (ctx1, "ctx1", "O", "1");
   ul (ctx2, "ctx2", "O", "1");
   ul (ctx1, "ctx1", "R", "1");
   ul (ctx2, "ctx2", "R", "2");
   ul (ctx2, "ctx2", "R", "1");   /* locked by ctx1 */
   ul (ctx1, "ctx1", "U", "1");
   fflush (stdout);
   if (system ("./other") != 0) {  /* record 2 still locked by ctx2 */
      return 1;
   }
   ul (ctx2, "ctx2", "R", "1");
   ul (ctx2, "ctx2", "U", "1");
   fflush (stdout);
   if (system ("./other") != 0) {
      return 1;
   }
   ul (ctx1, "ctx1", "C", "1");
   ul (ctx2, "ctx2", "C", "1");

   cob_context_destroy (ctx1);
   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

