AT_SETUP([CANCEL in one execution context])
AT_KEYWORDS([runreentrant cob_context_create cob_cancel CANCEL])

# CANCEL acts on the instance of the program in the current context
# only: the WORKING-STORAGE of the other contexts is kept

AT_DATA([counter.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      counter.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9(4) VALUE 0.
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       PROCEDURE        DIVISION USING TAG.
           ADD 1 TO CNT
           DISPLAY TAG ": " CNT
           GOBACK.
])

AT_DATA([canceller.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      canceller.
       PROCEDURE        DIVISION.
           CANCEL "counter"
           GOBACK.
])

AT_DATA([host.c], [[
#include <libcob.h>

static void
call_counter (cob_context *ctx, const char *tag)
{
   void *argv[1];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   (void)cob_call ("counter", 1, argv);
   cob_context_leave (prev);
}

static void
cancel_counter (cob_context *ctx, int from_cobol)
{
   cob_context *prev = cob_context_enter (ctx);
   if (from_cobol) {
      (void)cob_call ("canceller", 0, NULL);
   } else {
      cob_cancel ("counter");
   }
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *main_ctx, *ctx2;

   cob_init (argc, argv);
   main_ctx = cob_get_current_context ();
   ctx2 = cob_context_create ();

   call_counter (main_ctx, "main");
   call_counter (main_ctx, "main");
   call_counter (ctx2, "ctx2");
   call_counter (ctx2, "ctx2");

   /* two CANCELs in a row, in two contexts */
   cancel_counter (ctx2, 0);
   call_counter (main_ctx, "main");
   cancel_counter (main_ctx, 1);
   call_counter (main_ctx, "main");
   call_counter (ctx2, "ctx2");
   call_counter (main_ctx, "main");

   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE counter.cob], [0], [], [])
AT_CHECK([$COMPILE_MODULE canceller.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./host], [0],
[main: 0001
main: 0002
ctx2: 0001
ctx2: 0002
main: 0003
main: 0001
ctx2: 0001
main: 0002
], [])

AT_CLEANUP


AT_SETUP([physical CANCEL with several execution contexts])
AT_KEYWORDS([runreentrant cob_context_create cob_cancel CANCEL COB_PHYSICAL_CANCEL])

# the module of a program is not unloaded by a physical CANCEL while
# other contexts exist: they may have an instance of it; the CANCEL is
# then only logical, the other contexts keep their WORKING-STORAGE

AT_DATA([counter.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      counter.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9(4) VALUE 0.
       01 TXT           PIC X(8) VALUE "counter".
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       PROCEDURE        DIVISION USING TAG.
           ADD 1 TO CNT
           DISPLAY TAG ": " TXT " " CNT
           GOBACK.
])

AT_DATA([host.c], [[
#include <libcob.h>

static void
call_counter (cob_context *ctx, const char *tag)
{
   void *argv[1];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   (void)cob_call ("counter", 1, argv);
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *main_ctx, *ctx2;

   cob_init (argc, argv);
   main_ctx = cob_get_current_context ();
   ctx2 = cob_context_create ();

   call_counter (ctx2, "ctx2");
   call_counter (main_ctx, "main");
   cob_cancel ("counter");
   call_counter (main_ctx, "main");
   call_counter (ctx2, "ctx2");

   /* the last other context is destroyed: CANCEL is physical again */
   cob_context_destroy (ctx2);
   call_counter (main_ctx, "main");
   cob_cancel ("counter");
   call_counter (main_ctx, "main");
   cob_stop_run (0);
}
]])

AT_CHECK([$COMPILE host.c], [0], [], [])
AT_CHECK([$COMPILE_MODULE counter.cob], [0], [], [])
AT_CHECK([COB_PHYSICAL_CANCEL=1 $COBCRUN_DIRECT ./host], [0],
[ctx2: counter  0001
main: counter  0001
main: counter  0001
ctx2: counter  0002
main: counter  0002
main: counter  0001
], [])

AT_CLEANUP


AT_SETUP([record locks of INDEXED files between execution contexts])
AT_KEYWORDS([runreentrant cob_context_create INDEXED LOCK])

AT_SKIP_IF([test "$COB_HAS_ISAM" = "no"])

# each context has its own record locks: a record locked in a context
# cannot be locked in another one until it is released

AT_DATA([lk.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      lk.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT IX ASSIGN TO "ixfile"
                  ORGANIZATION INDEXED ACCESS DYNAMIC
                  RECORD KEY IK
                  LOCK MODE MANUAL
                  SHARING WITH ALL OTHER
                  STATUS FS.
       DATA             DIVISION.
       FILE             SECTION.
       FD IX.
       01 IR.
          05 IK         PIC X(4).
          05 IDATA      PIC X(10).
       WORKING-STORAGE  SECTION.
       01 FS            PIC XX.
       LINKAGE          SECTION.
       01 TAG           PIC X(4).
       01 OP            PIC X.
       PROCEDURE        DIVISION USING TAG OP.
           EVALUATE OP
           WHEN "W"
              OPEN OUTPUT IX
              MOVE "K001" TO IK
              MOVE "data" TO IDATA
              WRITE IR
              CLOSE IX
           WHEN "O"
              OPEN I-O IX
           WHEN "R"
              MOVE "K001" TO IK
              READ IX WITH LOCK
           WHEN "U"
              UNLOCK IX
           WHEN "C"
              CLOSE IX
           END-EVALUATE
           DISPLAY TAG " " OP ": " FS
           GOBACK.
])

AT_DATA([host.c], [[
#include <libcob.h>

static void
lk (cob_context *ctx, const char *tag, const char *op)
{
   void *argv[2];
   cob_context *prev = cob_context_enter (ctx);
   argv[0] = (void *)tag;
   argv[1] = (void *)op;
   (void)cob_call ("lk", 2, argv);
   cob_context_leave (prev);
}

int
main (int argc, char **argv)
{
   cob_context *ctx1, *ctx2;

   cob_init (argc, argv);
   ctx1 = cob_context_create ();
   ctx2 = cob_context_create ();

   lk (ctx1, "ctx1", "W");
   lk (ctx1, "ctx1", "O");
   lk (ctx2, "ctx2", "O");
   lk (ctx1, "ctx1", "R");
   lk (ctx2, "ctx2", "R");   /* locked by ctx1 */
   lk (ctx1, "ctx1", "U");
   lk (ctx2, "ctx2", "R");
   lk (ctx1, "ctx1", "R");   /* locked by ctx2 */
   lk (ctx2, "ctx2", "C");
   lk (ctx1, "ctx1", "R");
   lk (ctx1, "ctx1", "C");

   cob_context_destroy (ctx1);
   cob_context_destroy (ctx2);
   cob_stop_run (0);
}
]])

